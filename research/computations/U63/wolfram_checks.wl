(* Call 1, separate stateless evaluator, timeConstraint=60. Actual expression. *)
Module[{q=11,chi,count1,count2,rows,sub,sq,twosq,poly,xx,yy,tt,ww,kk,pi,expr,target,mod125,us,vs,pairs,hasroot,quadSquares}, chi[n_]:=If[Mod[n,q]==0,0,JacobiSymbol[Mod[n,q],q]]; count1[u_,v_,sg_]:=q+1+Sum[chi[sg*(x^5+40*u*v*x^3+320*u^2*v^2*x+64*(8*v^5-u^5))],{x,0,q-1}]; count2[u_,v_]:=q^2+1+Sum[With[{a=Mod[x^5-10*x^3*y^2+5*x*y^4+40*u*v*(x^3-3*x*y^2)+320*u^2*v^2*x+64*(8*v^5-u^5),q],b=Mod[5*x^4*y-10*x^2*y^3+y^5+40*u*v*(3*x^2*y-y^3)+320*u^2*v^2*y,q]},If[a==0&&b==0,0,chi[a^2+b^2]]],{x,0,q-1},{y,0,q-1}]; rows=Flatten[Table[If[u==0&&v==0,Nothing,With[{s=q+1-count1[u,v,1],n=count2[u,v]},With[{p=(s^2-(q^2+1-n))/2-2*q},{u,v,s,p,s^2-4*p}]]],{u,0,q-1},{v,0,q-1}],1]; sq=Union[Mod[Range[0,q-1]^2,q]];twosq=Union[Mod[2*Range[0,q-1]^2,q]];sub=Select[rows,MemberQ[sq,#[[1]]]&&MemberQ[twosq,#[[2]]]&];poly[z_]:=z^5+80*xx^2*yy^2*z^3+1280*xx^4*yy^4*z+64*(256*yy^10-xx^10);expr=Expand[((16*ww+8*kk)^2+poly[pi^8*tt])/256];target=ww^2+kk*ww+tt^5+5*xx^2*yy^2*pi^4*tt^3+5*xx^4*yy^4*pi^8*tt;mod125=125;us=Union[Mod[Range[0,124]^2,125]];vs=Union[Mod[2*Range[0,124]^2,125]];pairs=Select[Tuples[{us,vs}],Mod[#[[1]]^5+8*#[[2]]^5,5]!=0&];hasroot[{u_,v_}]:=AnyTrue[Range[0,124],Mod[#^5+40*u*v*#^3+320*u^2*v^2*#+64*(8*v^5-u^5),125]==0&];quadSquares=Union[Flatten[Table[{Mod[a^2+b^2,4],Mod[2*a*b+b^2,4]},{a,0,3},{b,0,3}],1]];<|"full_q11"->Tally[Sort[#[[3;;5]]&/@rows]],"square_q11"->Tally[Sort[#[[3;;5]]&/@sub]],"sample_1_0"->{count1[1,0,1],count2[1,0],count1[1,0,-1]},"twisted_model_identity"->(PolynomialRemainder[PolynomialRemainder[expr-target,kk^2-xx^10+256*yy^10,kk],pi^5-2,pi]===0),"mod125_pairs"->Length[pairs],"mod125_pairs_with_root"->Count[hasroot/@pairs,True],"quadratic_algebra_squares_mod4"->quadSquares|>]

(* Call 2, separate stateless evaluator, timeConstraint=40. Actual expression. *)
Module[{p=11,ff,n1,n2,chi,x,y,e,t,w,pi,k,xx,yy,expression,target,atInfinity,u,v,a,b},ff[z_]:=z^5+64*8*2^5;chi[z_]:=If[Mod[z,p]==0,0,JacobiSymbol[Mod[z,p],p]];n1=p+1+Sum[chi[ff[x]],{x,0,p-1}];n2=p^2+1+Sum[With[{aa=Mod[x^5-10*x^3*y^2+5*x*y^4+64*8*2^5,p],bb=Mod[5*x^4*y-10*x^2*y^3+y^5,p]},chi[aa^2+bb^2]],{x,0,p-1},{y,0,p-1}];expression=Expand[((16*w+8*k)^2+(pi^8*t)^5+80*xx^2*yy^2*(pi^8*t)^3+1280*xx^4*yy^4*pi^8*t+64*(256*yy^10-xx^10))/256];target=w^2+k*w+t^5+5*xx^2*yy^2*pi^4*t^3+5*xx^4*yy^4*pi^8*t;atInfinity=v^2+k*v*u^3+u+a*u^3+b*u^5;<|"witness_U_V"->{0,2},"witness_N11_N121"->{n1,n2},"weighted_congruence_X_Y_Z"->Mod[0^10+256-PowerMod[5,17,p],p],"Hecke_sum_product"->{Expand[-e-1+e],PolynomialRemainder[(-e-1)*e,e^2+e-1,e]},"negative_twist_model_remainder"->PolynomialRemainder[PolynomialRemainder[expression-target,k^2-xx^10+256*yy^10,k],pi^5-2,pi],"infinity_derivative"->(D[atInfinity,u]/.{u->0,v->0}),"negative_twist_trace_sums_mod17"->Mod[{-3,1,9},17],"actual_form_a_sum_mod17"->Mod[-1,17]|>]
