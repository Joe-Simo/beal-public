(* These are the two actual external Wolfram calls, each with timeConstraint=60.
The label maximal_order_discriminant computes the polynomial discriminant;
maximality is supplied by the manuscript, not by that label. *)
Module[{t,u,c,h,f,cmat,b9,ps,prod,d,threshold,coef,term,k,vec,rem,profiles,ee,prec,bound},f=t^10+4;h=u^10+2u^5+2;c=-u^8-2u^3;cmat=Table[Coefficient[PolynomialRemainder[c^j,h,u],u,i],{i,0,9},{j,0,9}];b9=Binomial[1/17,9];ps={11,31,41,61,71,101,151,191,211,281,331,431,461,631};prod=Times@@ps;d=11*101*(17prod)^9;profiles=Table[prec=9(ee-1)+10;coef=Table[Sum[If[Mod[k,10]==j,Binomial[1/17,k]*17^(ee*k)*(-256)^Quotient[k,10],0],{k,0,Ceiling[16prec/15]+10}],{j,0,9}];{ee,Table[IntegerExponent[Numerator[coef[[j+1]]],17]-IntegerExponent[Denominator[coef[[j+1]]],17],{j,0,9}]},{ee,2,4}];<|"new_generator_relations"->{PolynomialRemainder[(u^5+1)^2+1,h,u],PolynomialRemainder[(u^7+u^2)^5-2,h,u],PolynomialRemainder[c-(u^5+1)*(u^7+u^2)^4,h,u],PolynomialRemainder[c^10+256,h,u]},"maximal_order_discriminant"->Discriminant[h,u],"power_order_index"->Abs[Det[cmat]],"binomial_ninth"->b9,"ninth_numerator_factorization"->FactorInteger[Numerator[b9]],"seventeen_profiles"->profiles,"forcing_prime_automorphism_rows"->Table[{q,If[Mod[q,4]==1,5,10],PowerMod[q,If[Mod[q,4]==1,5,10],17]},{q,ps}],"coefficient_divisor"->d,"bound_4810_verified"->(16^153*d^85>243*10^(5*4810)),"same_bound_does_not_reach_4811"->(16^153*d^85<243*10^(5*4811))|>]

Module[{c,f,pow,root,series,qs,rows,profiles,m,r,e,n,cut},f=c^10+256;pow[a_,nn_,mm_]:=Module[{b=PolynomialMod[a,mm],o=1,k=nn},While[k>0,If[OddQ[k],o=PolynomialMod[PolynomialRemainder[o*b,f,c],mm]];b=PolynomialMod[PolynomialRemainder[b*b,f,c],mm];k=Quotient[k,2]];o];series[pp_,ee_,nn_,aa_,vv_]:=Module[{mm=pp^nn,lim,coeff,v},lim=If[pp==17,Ceiling[16nn/15]+1,nn];coeff=Table[Sum[If[Mod[k,10]==j,v=aa*Binomial[1/17,k]*(vv*pp^ee/aa^17)^k*(-256)^Quotient[k,10];Mod[Numerator[v]*PowerMod[Denominator[v],-1,mm],mm],0],{k,0,lim-1}],{j,0,9}];Sum[Mod[coeff[[j+1]],mm]*c^j,{j,0,9}]];profiles=Table[n=9(e-1)+10;m=17^n;r=series[17,e,n,1,1];{e,pow[r,17,m]==1+17^e*c,Table[IntegerExponent[Coefficient[r,c,j],17],{j,0,9}]},{e,2,4}];qs={11,31,41,61,71,101,151,191,211,281,331,431,461,631};rows=Table[m=q^12;r=series[q,1,12,2,1];{q,pow[r,17,m]==Mod[2^17,m]+q*c,Table[IntegerExponent[Coefficient[r,c,j],q],{j,0,9}]},{q,qs}];<|"seventeen_root_checks"->profiles,"forcing_prime_root_checks"->rows,"all_power_equations_pass"->(And@@profiles[[All,2]]&&And@@rows[[All,2]])|>]
